{
  "manifest_version": 2,
  "author": "Naem",
  "name": "Keep Playing for YouTube & YouTube Music",
  "version": "2.0.1",
  "description": "Prevents/auto-confirms 'Are you still there?' popups on YouTube and YouTube Music. Auto-recovers from playback stalls on YouTube Music.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-music-ns-solo@yourname.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
